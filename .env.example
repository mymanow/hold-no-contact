# Copier en .env.local et remplir. Ne jamais commiter .env.local.

# Supabase (local : `npx supabase start` affiche ces valeurs)
NEXT_PUBLIC_SUPABASE_URL=
# Clé publishable (sb_publishable_…) — l'ancienne clé anon fonctionne aussi
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL publique de l'app (liens de connexion, retour OAuth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Chiffrement applicatif des champs sensibles : JSON {"version":"base64 de 32 octets"}
# Générer une clé : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEYS={"1":""}
DATA_ENCRYPTION_KEY_CURRENT=1

# Jalons suivants (pas encore utilisés)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_MONTHLY=
# STRIPE_PRICE_LIFETIME=
# RESEND_API_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# CRON_SECRET=
