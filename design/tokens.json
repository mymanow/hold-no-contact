    "mono": "ui-monospace, SFMono-Regular, Menlo, monospace",
    "_note": "Polices libres (OFL), auto-hébergées via @fontsource-variable (aucune requête vers Google). Atkinson Hyperlegible Next : lisibilité sous stress. Fraunces : chiffres du compteur. Thai plus tard : ajouter 'IBM Plex Sans Thai' en repli."
  },
  "type": {
    "xs": {
      "size": 13,
      "line": 18,
      "weight": 500,
      "_use": "méta, badges — jamais en dessous de 13px"
    },
    "sm": {
      "size": 15,
      "line": 22,
      "weight": 400,
      "_use": "texte secondaire, labels"
    },
    "base": {
      "size": 17,
      "line": 26,
      "weight": 400,
      "_use": "corps — 17px pour lecture nocturne sur téléphone"
    },
    "lg": {
      "size": 20,
      "line": 28,
      "weight": 600,
      "_use": "titres de carte"
    },
    "xl": {
      "size": 26,
      "line": 32,
      "weight": 700,
      "font": "display",
      "_use": "titres de page"
    },
    "2xl": {
      "size": 34,
      "line": 40,
      "weight": 600,
      "font": "display",
      "_use": "titres hero, Panic Room"
    },
    "counter": {
      "size": "clamp(72px, 18vw, 112px)",
      "line": 1,
      "weight": 600,
      "font": "display",
      "tracking": "-0.02em",
      "numeric": "tabular-nums lining-nums",
      "_use": "chiffre du streak"
    }
