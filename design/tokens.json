    "xl": 28,
    "pill": 999
  },
  "shadow": {
    "_note": "En dark mode l'élévation vient surtout des surfaces (surface → surface-raised). Les ombres restent discrètes.",
    "card": "0 1px 0 rgba(255,255,255,.03) inset, 0 8px 24px rgba(0,0,0,.35)",
    "pop": "0 16px 48px rgba(0,0,0,.55)",
    "panic-glow": "0 0 0 6px rgba(255,122,89,.16), 0 10px 32px rgba(255,122,89,.32)",
    "accent-glow": "0 0 0 1px rgba(95,211,166,.25), 0 12px 40px rgba(95,211,166,.12)"
  },
  "motion": {
    "fast": "120ms",
    "base": "220ms",
    "slow": "420ms",
    "ease": "cubic-bezier(.2,.8,.2,1)",
    "ease-calm": "cubic-bezier(.45,0,.25,1)",
    "breath-in": "4000ms",
    "breath-hold": "4000ms",
    "breath-out": "6000ms",
    "_note": "prefers-reduced-motion : aucune animation de pulse, la respiration passe en texte + compte à rebours."
  },
  "layout": {
    "breakpoint-md": 768,
    "breakpoint-lg": 1024,
    "breakpoint-xl": 1280,
    "content-max": 720,
    "content-wide-max": 1080,
    "gutter-mobile": 16,
    "gutter-desktop": 32,
    "header-height": 56,
    "tabbar-height": 64,
    "sidebar-width": 264,
    "sidebar-collapsed": 72,
    "touch-min": 48,
    "panic-fab-size": 64,
    "panic-hero-size": 200,
    "safe-area-bottom": "env(safe-area-inset-bottom)",
    "_shell": "< md : header + bottom tab bar (Accueil · Ick List · Sam · Outils · Profil) + FAB Panic fixe au-dessus de la tab bar. ≥ lg : sidebar gauche (nav + bouton Panic pleine largeur en bas), contenu centré content-max. md–lg : sidebar réduite (icônes)."
  },
  "z": {
    "base": 0,
    "sticky": 10,
    "tabbar": 20,
    "fab": 30,
    "sheet": 40,
    "modal": 50,
    "toast": 60,
    "panic": 70
